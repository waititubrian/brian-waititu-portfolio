# Resend API key used by the contact form Server Action (src/lib/actions/contact.ts).
# Get one at https://resend.com/api-keys, then copy this file to .env.local
# and fill in real values. .env.local is gitignored.
RESEND_API_KEY=

# Optional: verified sender address once you've added/verified a domain in Resend.
# Defaults to Resend's shared onboarding@resend.dev sender if unset.
CONTACT_FROM_EMAIL=
